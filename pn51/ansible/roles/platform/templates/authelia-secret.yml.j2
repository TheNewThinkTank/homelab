apiVersion: v1
kind: Secret
metadata:
  name: authelia-config
  namespace: platform
type: Opaque
stringData:
  configuration.yml: |
    server:
      address: tcp://0.0.0.0:9091
      disable_healthcheck: true
    log:
      level: info
    ntp:
      address: udp://time.cloudflare.com:123
    identity_validation:
      reset_password:
        jwt_secret: {{ authelia_jwt_secret | to_json }}
    authentication_backend:
      file:
        path: /config/users_database.yml
        watch: false
    access_control:
      default_policy: deny
      rules:
        - domain:
            - {{ ('grafana.' ~ lab_domain) | to_json }}
            - {{ ('prometheus.' ~ lab_domain) | to_json }}
            - {{ ('alertmanager.' ~ lab_domain) | to_json }}
            - {{ ('headlamp.' ~ lab_domain) | to_json }}
            - {{ ('homepage.' ~ lab_domain) | to_json }}
            - {{ ('argocd.' ~ lab_domain) | to_json }}
            - {{ ('fitness.' ~ lab_domain) | to_json }}
          subject: ["group:admins"]
          policy: two_factor
    session:
      secret: {{ authelia_session_secret | to_json }}
      same_site: lax
      inactivity: 5m
      expiration: 1h
      remember_me: 7d
      cookies:
        - domain: {{ lab_domain | to_json }}
          authelia_url: {{ ('https://auth.' ~ lab_domain) | to_json }}
          default_redirection_url: {{ ('https://homepage.' ~ lab_domain) | to_json }}
    regulation:
      max_retries: 3
      find_time: 2m
      ban_time: 5m
    storage:
      encryption_key: {{ authelia_storage_key | to_json }}
      local:
        path: /data/db.sqlite3
    notifier:
      filesystem:
        filename: /data/notifications.txt
  users_database.yml: |
    users:
      {{ authelia_username }}:
        displayname: {{ authelia_username | to_json }}
        password: {{ authelia_password_hash | to_json }}
        email: {{ (authelia_username ~ '@' ~ lab_domain) | to_json }}
        groups: [admins]
